# Ergo Miner Configuration Example

# Primary Pool and Wallet
POOL_ADDRESS=stratum+tcp://erg.2miners.com:8080
BACKUP_POOL_ADDRESS=stratum+tcp://herominers.com:1180
WALLET_ADDRESS=9gj5C7V6S6v7v6v7v6v7v6v7v6v7v6v7v6v7v6v7v6v7v6v7v6v
WORKER_NAME=ergo-miner

# Use an IPv4 or bracketed IPv6 address for published ports.
# Loopback keeps those ports local to this machine.
HOST_BIND_ADDRESS=127.0.0.1

# MINER accepts lolminer or t-rex; invalid values stop startup.
MINER=lolminer
LOLMINER_VERSION=1.98a
T_REX_VERSION=0.26.8

# GPU selection: AUTO or unique comma-separated non-negative IDs such as 0,1.
GPU_DEVICES=AUTO
# Flags use lowercase true/false; MULTI_PROCESS=true runs one process per GPU.
MULTI_PROCESS=false

# Overclocking (NVIDIA only)
# Clock/memory offsets and power limits must be integers.
APPLY_OC=false
# GPU_PROFILE=RTX 3070
# Health checks use this profile's GPU_TEMP_THRESHOLD (80°C by default).
# GPU_CLOCK_OFFSET=-200
# GPU_MEM_OFFSET=800
# GPU_POWER_LIMIT=250

# Extra Arguments for the miner
EXTRA_ARGS=

# Auto Profit Switching
AUTO_PROFIT_SWITCHING=false

# Telegram Notifications
TELEGRAM_ENABLE=false
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_NOTIFY_THRESHOLD=300

# Dual Mining (lolMiner only)
# DUAL_ALGO=KASPADUAL
# DUAL_POOL=stratum+tcp://kas.2miners.com:2020
# DUAL_WALLET=kaspa:qpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqpqp
# DUAL_WORKER=ergo-miner-dual
